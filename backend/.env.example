# ─── HalShield Backend Configuration ───────────────────────

# JWT Authentication
JWT_SECRET_KEY=halshield-super-secret-change-in-production-2024
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM API Keys (optional — for SelfCheckGPT sampling)
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Model Configuration
NLI_MODEL=cross-encoder/nli-deberta-v3-base
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_MODEL=gpt-3.5-turbo

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./halshield.db

# FAISS Vector Store
FAISS_INDEX_PATH=./vectorstore

# File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
